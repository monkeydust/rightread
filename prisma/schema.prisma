// rightread — read-later capture + offline reader
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Models ─────────────────────────────────────────

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  items           Item[]
  captureTokens   CaptureToken[]
  sources         Source[]
  candidates      Candidate[]
  keyPhrases      KeyPhrase[]
  recommendations Recommendation[]
  memberOf        MemberOf[]
  shares          GroupShare[]
  dismissals      GroupShareDismissal[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── rightread Models ───────────────────────────────────────

/// Bearer token for non-browser capture clients (extension, iOS Shortcut, curl).
/// Only the SHA-256 hash is stored; the plaintext is shown once at creation.
model CaptureToken {
  id         String    @id @default(cuid())
  userId     String
  name       String // e.g. "Edge on desktop"
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Item {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url         String
  resolvedUrl String? // after redirects / tracking-param stripping
  title       String  @default("Untitled")
  siteName    String?
  byline      String?
  excerpt     String?
  leadImage   String?

  /// Sanitized article HTML rendered in the reader. Written only by
  /// src/lib/extract.ts, which runs it through the tag/attr allowlist first.
  contentHtml String?
  /// Plain text, used for search and word count.
  textContent String?
  wordCount   Int?

  /// 1536-dim float32 vector from OpenRouter, stored little-endian.
  /// Powers semantic search; null until embedded, and null is not an error.
  embedding      Bytes?
  embeddingModel String?
  embeddedAt     DateTime?

  /// pending | ok | failed — extraction runs async right after capture
  extractStatus String    @default("pending")
  extractError  String?
  extractedAt   DateTime?

  /// conversation | article | blog | reference | other — selects the summary prompt
  kind           String  @default("other")
  /// 0-1. Only a deterministic URL rule earns 1; the model is capped below it.
  kindConfidence Float   @default(0)
  /// user | url | llm | none — provenance, so a wrong answer is diagnosable
  kindSource     String  @default("none")
  kindReason     String?

  /// Saved via the recommendations panel rather than a capture path. Purely
  /// provenance — shown as a chip in the list, never affects ordering.
  recommended Boolean @default(false)

  /// unread | archived
  status   String    @default("unread")
  /// A marker you can filter by — deliberately NOT an ordering bucket.
  /// It used to be `pinned` and sorted above everything else, which split the
  /// queue in two: with one pinned item, up/down had no sibling to swap with
  /// and silently did nothing.
  starred  Boolean   @default(false)
  /// Sparse float ordering over the whole queue: a move writes one row
  /// (midpoint of neighbours), not the whole list. Lower sorts first.
  position Float     @default(0)
  /// 0..1 scroll position, so the reader reopens where you left off.
  progress Float     @default(0)
  readAt   DateTime?

  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, url])
  @@index([userId, status, position])
  @@index([userId, starred])
  @@index([userId, kind])
  @@index([userId, savedAt])
}

// ─── Recommendations ────────────────────────────────────────

/// A curated RSS/Atom feed the user wants recommendations drawn from.
/// Recommendations come ONLY from these — there is no discovery beyond them.
model Source {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feedUrl String
  /// From the feed's own <title>; filled on first successful fetch.
  title   String?
  siteUrl String?
  active  Boolean @default(true)

  /// Fetch bookkeeping. lastError is cleared on any successful poll, so a
  /// non-null value always describes the most recent attempt.
  lastFetchedAt DateTime?
  lastError     String?

  createdAt  DateTime    @default(now())
  candidates Candidate[]

  @@unique([userId, feedUrl])
  @@index([userId])
}

/// An article discovered in a Source's feed — a recommendation *candidate*,
/// deliberately not an Item. Items are the user's library and must never be
/// polluted by (or pruned along with) machine-fetched articles. Saving a
/// candidate goes through the normal capture flow, which creates a real Item;
/// savedItemId then excludes it from future recommendations.
model Candidate {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  url         String
  resolvedUrl String?
  title       String    @default("Untitled")
  siteName    String?
  excerpt     String?
  publishedAt DateTime?

  /// Plain text of the full article, kept so a model change can re-embed
  /// without refetching every page. No contentHtml: candidates are never
  /// rendered, only scored.
  textContent String?
  wordCount   Int?

  /// Same encoding as Item.embedding (float32 LE blob) so the two score
  /// against each other directly.
  embedding      Bytes?
  embeddingModel String?
  embeddedAt     DateTime?

  /// pending | ok | failed — full-text extraction of the candidate's page
  extractStatus String  @default("pending")
  extractError  String?

  /// Set when the user saves this recommendation into their queue.
  savedItemId String?

  recommendations Recommendation[]

  firstSeenAt DateTime @default(now())

  /// Set when the user says "not interested". Deliberately on the candidate
  /// rather than on the Recommendation: dismissing an article under one key
  /// phrase must not let a different phrase resurface it an hour later.
  dismissedAt DateTime?

  @@unique([userId, url])
  @@index([userId, embeddedAt])
  @@index([sourceId, firstSeenAt])
}

/// A standing semantic query — an interest declared once, matched against
/// everything the listeners bring in from then on.
model KeyPhrase {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text   String
  active Boolean @default(true)

  /// Same float32 LE blob as Item/Candidate, so it scores against them
  /// directly. Embedded once on create; re-embedded if the text is edited.
  embedding      Bytes?
  embeddingModel String?
  embeddedAt     DateTime?

  /// Watermark: only candidates embedded after this are scored on a sweep, so
  /// a poll costs what arrived rather than the whole pool. Cleared on edit,
  /// which backfills the phrase against everything already held.
  lastMatchedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, text])
  @@index([userId, active])
}

/// Why a candidate was surfaced. One row per (candidate, origin) pair.
model Recommendation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// "phrase" | "item", and the id of whichever it was.
  ///
  /// Two plain columns rather than two nullable foreign keys: SQLite treats
  /// NULLs as distinct in a unique index, so a nullable key cannot stop the
  /// same pair being inserted twice on the next sweep.
  originKind String
  originId   String

  score     Float
  createdAt DateTime @default(now())

  @@unique([userId, candidateId, originKind, originId])
  @@index([userId, score])
  @@index([originKind, originId])
}

// ─── Groups ─────────────────────────────────────────────────
//
// A reading club: several people who point each other at articles. Everything
// above this line is owned by exactly one user and read with `where: { userId }`.
// These four models are the exception — they are visible by *membership* — so
// every read of them goes through `src/lib/groups/access.ts` rather than being
// written inline. That is the whole containment strategy for the invariant.

/// A named shelf shared by its members. No roles: every member may rename the
/// group, invite, remove anyone, and share.
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members MemberOf[]
  shares  GroupShare[]
  invites GroupInvite[]
}

/// Membership. Named for what it asserts — that a user is in a group — rather
/// than `GroupMember`, which invites being read as a row that carries a role.
model MemberOf {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

/// An invitation waiting for an address to sign in.
///
/// Stored normalized by `normalizeEmail()` — the same canonicalization Auth.js
/// applies before writing `User.email` — so that the invite and the account it
/// is waiting for actually match. Redeemed in the `signIn` callback.
///
/// Note that an invite is not permission to sign in: `RIGHTREAD_ALLOWED_EMAILS`
/// remains the gate, so an invite to an address that is not on it sits here,
/// valid but dormant, until that variable is changed on the server.
model GroupInvite {
  id        String   @id @default(cuid())
  groupId   String
  email     String
  invitedBy String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, email])
  @@index([email])
}

/// A link on a group's shelf.
///
/// Carries its own snapshot of the article rather than pointing at the sharer's
/// Item: the shelf survives the sharer deleting or archiving their own copy,
/// which a pointer would not given every foreign key here cascades, and saving
/// a share is then just an ordinary `captureUrl()`, so the saved row is a normal
/// Item that sorts, stars, searches and graphs with no special cases anywhere.
///
/// There is deliberately no `contentHtml` here, and adding one would be a
/// mistake worth arguing about first. `Item.contentHtml` is not always
/// server-fetched — `applyProvidedContent()` stores HTML the sharer's own
/// browser supplied, from a paywalled page they were logged into or one behind
/// a check they personally passed. Serving that to a group turns "I saved my
/// copy" into "I republished it", a decision they never made. It also changes
/// the blast radius of a sanitizer bypass from self-XSS into cross-account XSS,
/// in a same-origin app holding a year-long session cookie. Reading happens in
/// your own copy, after Save.
///
/// The cost is a snapshot that can age and a second extraction per member who
/// saves. Both are cheap next to the alternative.
model GroupShare {
  id      String @id @default(cuid())
  groupId String

  /// Nullable with SetNull, not Cascade, and this is load-bearing: every other
  /// foreign key in this schema cascades, but a share is not the sharer's
  /// property — it is on a shelf other people read. Cascading would mean one
  /// person closing their account silently erased every link they had ever
  /// contributed, from every group, for everyone. `sharedByLabel` keeps the
  /// attribution readable after the account is gone.
  sharedByUserId String?
  /// Denormalized at share time so the card still says who shared it once the
  /// relation above has been nulled. Same reasoning as `GroupInvite.invitedBy`.
  sharedByLabel  String  @default("")

  /// normalizeUrl()'d. With groupId this is the natural key: one shelf slot per
  /// link, so re-sharing refreshes rather than duplicating.
  url       String
  title     String   @default("Untitled")
  siteName  String?
  excerpt   String?
  leadImage String?
  /// Optional "why I'm sharing this".
  note      String?
  sharedAt  DateTime @default(now())
  /// When the snapshot was last filled from a real extraction. Null means the
  /// card is still whatever was known at share time — usually just a hostname,
  /// because capture returns before extraction finishes. Distinguishing "never
  /// filled" from "filled a while ago" is what lets the backfill in
  /// `persistArticle` improve a card without ever downgrading one.
  snapshotAt DateTime?

  group      Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sharedBy   User?                 @relation(fields: [sharedByUserId], references: [id], onDelete: SetNull)
  dismissals GroupShareDismissal[]

  @@unique([groupId, url])
  @@index([groupId, sharedAt])
}

/// One member hiding one share from their own view of the shelf.
///
/// Dismissing is per-person on purpose: it must not overrule the person who
/// shared, and it is not a delete. A re-share clears it, so someone can put a
/// link back in front of the group.
model GroupShareDismissal {
  id      String   @id @default(cuid())
  shareId String
  userId  String
  at      DateTime @default(now())

  share GroupShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([userId])
}
