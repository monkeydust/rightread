// rightread — read-later capture + offline reader
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Auth.js Models ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  items         Item[]
  captureTokens CaptureToken[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── rightread Models ───────────────────────────────────────

/// Bearer token for non-browser capture clients (extension, iOS Shortcut, curl).
/// Only the SHA-256 hash is stored; the plaintext is shown once at creation.
model CaptureToken {
  id         String    @id @default(cuid())
  userId     String
  name       String // e.g. "Edge on desktop"
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Item {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url         String
  resolvedUrl String? // after redirects / tracking-param stripping
  title       String  @default("Untitled")
  siteName    String?
  byline      String?
  excerpt     String?
  leadImage   String?

  /// Sanitized article HTML rendered in the reader. Written only by
  /// src/lib/extract.ts, which runs it through the tag/attr allowlist first.
  contentHtml String?
  /// Plain text, used for search and word count.
  textContent String?
  wordCount   Int?

  /// pending | ok | failed — extraction runs async right after capture
  extractStatus String    @default("pending")
  extractError  String?
  extractedAt   DateTime?

  /// conversation | article | blog | reference | other — selects the summary prompt
  kind           String  @default("other")
  /// 0-1. Only a deterministic URL rule earns 1; the model is capped below it.
  kindConfidence Float   @default(0)
  /// user | url | llm | none — provenance, so a wrong answer is diagnosable
  kindSource     String  @default("none")
  kindReason     String?

  /// unread | archived
  status   String    @default("unread")
  /// A marker you can filter by — deliberately NOT an ordering bucket.
  /// It used to be `pinned` and sorted above everything else, which split the
  /// queue in two: with one pinned item, up/down had no sibling to swap with
  /// and silently did nothing.
  starred  Boolean   @default(false)
  /// Sparse float ordering over the whole queue: a move writes one row
  /// (midpoint of neighbours), not the whole list. Lower sorts first.
  position Float     @default(0)
  /// 0..1 scroll position, so the reader reopens where you left off.
  progress Float     @default(0)
  readAt   DateTime?

  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, url])
  @@index([userId, status, position])
  @@index([userId, starred])
  @@index([userId, kind])
  @@index([userId, savedAt])
}
